# Google Gemini API key (free tier at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Overleaf session cookie (raw value of overleaf_session2)
# Log into overleaf.com → DevTools → Application → Cookies
OVERLEAF_SESSION_COOKIE=your_overleaf_session2_cookie_value

# Overleaf GCLB cookie (raw value of GCLB)
OVERLEAF_GCLB_TOKEN=your_gclb_cookie_value

# Optional: server port for local development (default 3001)
PORT=3001

# Optional: allowed frontend origin for CORS (local dev only; same-origin on Vercel)
# CLIENT_ORIGIN=http://localhost:5173
